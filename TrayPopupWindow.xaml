<Window x:Class="NetTrace.TrayPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:NetTrace.Controls"
        xmlns:resources="clr-namespace:NetTrace.Resources"
        Title="NetTrace tray" Width="340" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="Manual"
        ShowInTaskbar="False" Topmost="True" AllowsTransparency="True"
        Background="Transparent" Foreground="#F8FAFC" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <resources:StatusColors/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="MutedText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#94A3B8"/>
                <Setter Property="FontSize" Value="11"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="#0A1020" BorderBrush="#1E2A44" BorderThickness="1"
            CornerRadius="12" Padding="14">
        <StackPanel>
            <Grid Height="28">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/NetTrace;component/assets/Network Globe Icon.png" Width="26" Height="26"
                           Margin="0,0,8,0" AutomationProperties.Name="NetTrace logo"/>
                    <TextBlock Text="NetTrace" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Border x:Name="VpnKeyIndicator" Width="22" Height="22" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Background="Transparent" Visibility="Collapsed"
                        AutomationProperties.Name="VPN Connected"
                        AutomationProperties.HelpText="An active VPN or tunnel was detected. Encryption and security are not verified."
                        ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="20000">
                    <Border.ToolTip>
                        <ToolTip x:Name="VpnKeyToolTip" Background="#172036" Foreground="#F8FAFC"
                                 BorderBrush="#2B3957" BorderThickness="1" Padding="10" MaxWidth="302">
                            <TextBlock x:Name="VpnKeyTooltipText" Text="VPN Connected" TextWrapping="Wrap" MaxWidth="280"/>
                        </ToolTip>
                    </Border.ToolTip>
                    <Path Width="16" Height="10" Stretch="Uniform" HorizontalAlignment="Center"
                          VerticalAlignment="Center" Fill="{StaticResource StatusInfoBrush}"
                          Data="F0 M 6.2,0 A 6.2,6.2 0 0 1 12.04,4.1 L 22.8,4.1 L 22.8,8.3 L 20.7,8.3 L 20.7,12.4 L 16.5,12.4 L 16.5,8.3 L 12.04,8.3 A 6.2,6.2 0 1 1 6.2,0 Z M 8.25,6.2 A 2.05,2.05 0 1 1 4.15,6.2 A 2.05,2.05 0 1 1 8.25,6.2 Z"/>
                </Border>
            </Grid>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="↓ Download" Foreground="{x:Static controls:DashboardTrafficChart.DownloadBrush}" FontSize="11"/>
                    <TextBlock x:Name="DownloadSpeedText" Text="0 B/s" FontSize="22" FontWeight="SemiBold"
                               AutomationProperties.Name="Current Download speed"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="↑ Upload" Foreground="{x:Static controls:DashboardTrafficChart.UploadBrush}" FontSize="11"/>
                    <TextBlock x:Name="UploadSpeedText" Text="0 B/s" FontSize="22" FontWeight="SemiBold"
                               AutomationProperties.Name="Current Upload speed"/>
                </StackPanel>
            </Grid>

            <Border Background="#111A2E" BorderBrush="#1E2A44" BorderThickness="1" CornerRadius="8"
                    Margin="0,8,0,0" Padding="3,0">
                <controls:DashboardTrafficChart x:Name="TrafficChart" Height="126"
                    AutomationProperties.Name="Last 60 seconds of Download and Upload traffic"/>
            </Border>

            <Grid x:Name="TodayUsage" Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="TODAY" Style="{StaticResource MutedText}"/>
                <TextBlock x:Name="TodayTotalText" Grid.Row="1" Text="0 B" FontSize="21" FontWeight="SemiBold"
                           AutomationProperties.Name="Today total usage"/>
                <Grid Grid.Row="2" Margin="0,1,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TodayDownloadText" Text="Download 0 B" FontSize="11"
                               Foreground="{x:Static controls:DashboardTrafficChart.DownloadBrush}"/>
                    <TextBlock x:Name="TodayUploadText" Grid.Column="1" Text="Upload 0 B" FontSize="11"
                               Foreground="{x:Static controls:DashboardTrafficChart.UploadBrush}"/>
                </Grid>
            </Grid>

            <Border BorderBrush="#1E2A44" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,9,0,0">
                <StackPanel Orientation="Horizontal" ToolTip="Whether NetTrace is collecting traffic. This does not represent network health.">
                    <Ellipse x:Name="MonitoringStatusDot" Width="7" Height="7" Fill="{StaticResource StatusNeutralBrush}"
                             VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock x:Name="MonitoringStatusText" Text="Monitoring" FontSize="11"
                               Foreground="{StaticResource StatusNeutralBrush}" MaxWidth="278"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
