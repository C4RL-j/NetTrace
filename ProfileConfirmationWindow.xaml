<Window x:Class="NetTrace.ProfileConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm profile change" Width="480" MinWidth="420" SizeToContent="Height"
        MaxHeight="500" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="#0A1020" Foreground="#F8FAFC">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Background" Value="#172036"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#2B3957"/>
            <Setter Property="MinWidth" Value="76"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="22">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="320">
            <TextBlock x:Name="ConfirmationMessageText" TextWrapping="Wrap" FontSize="14"/>
        </ScrollViewer>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="ConfirmActionButton" Content="Confirm" IsDefault="True" Click="ConfirmAction_OnClick" Margin="0,0,8,0"/>
            <Button x:Name="CancelActionButton" Content="Cancel" IsCancel="True" Click="CancelAction_OnClick"/>
        </StackPanel>
    </StackPanel>
</Window>
