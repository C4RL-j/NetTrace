<Window x:Class="NetTrace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:NetTrace.Controls"
        xmlns:resources="clr-namespace:NetTrace.Resources"
        Title="NetTrace"
        Icon="/NetTrace;component/assets/NetTrace.ico"
        Width="920" Height="740"
        MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#0A1020"
        Foreground="#F8FAFC">

    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <resources:StatusColors/>
        </ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="CardBrush" Color="#111A2E"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#1E2A44"/>

        <Style TargetType="Border" x:Key="CardStyle">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="MutedText">
            <Setter Property="Foreground" Value="{StaticResource SubtleBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>


        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="#172036"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#2B3957"/>
        </Style>

        <Style x:Key="NavigationTabStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource SubtleBrush}"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="FocusBorder" BorderBrush="Transparent" BorderThickness="1"
                                    Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                                  TextElement.FontSize="14" TextElement.FontWeight="SemiBold"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="ActiveIndicator" Height="3" VerticalAlignment="Bottom"
                                    Background="Transparent"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                                <Setter TargetName="ActiveIndicator" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavigationStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource NavigationTabStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"
                                          KeyboardNavigation.DirectionalNavigation="Contained"/>
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" Margin="0,18,0,0"
                                              ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Image Source="/NetTrace;component/assets/Network Globe Icon.png"
                   Width="48" Height="48" Margin="0,0,12,0"
                   VerticalAlignment="Center" AutomationProperties.Name="NetTrace logo"/>
            <StackPanel>
                <TextBlock Text="NetTrace" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Lightweight network usage monitor" Margin="0,5,0,0" Style="{StaticResource MutedText}"/>
            </StackPanel>
        </StackPanel>

        <TabControl x:Name="MainNavigation" Grid.Row="2" Style="{StaticResource NavigationStyle}"
                    SelectedIndex="0" TabStripPlacement="Top" AutomationProperties.Name="Main navigation">
            <TabItem x:Name="DashboardTab" Header="Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="DashboardContent">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="LIVE TRAFFIC" Grid.ColumnSpan="3" Style="{StaticResource MutedText}" Margin="0,0,0,8"
                                       ToolTip="Current traffic on the monitored adapter, measured passively. This is not an internet speed test."/>

                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="↓ Download" Style="{StaticResource MutedText}"/>
                                    <TextBlock x:Name="DownloadRateText" Text="0.00 Mbps" FontSize="34" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="DownloadPeakText" Text="Peak today ↓ 0.00 Mbps" Style="{StaticResource MutedText}" Margin="0,6,0,0"
                                               ToolTip="Highest sampled download traffic NetTrace observed today across monitored adapters. Saved across restarts; not a speed-test result."/>
                                    <TextBlock x:Name="DownloadSessionText" Text="App session ↓ 0 B" Style="{StaticResource MutedText}" Margin="0,8,0,0"
                                               ToolTip="Download data measured since this NetTrace process started, including time with the dashboard closed."/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="↑ Upload" Style="{StaticResource MutedText}"/>
                                    <TextBlock x:Name="UploadRateText" Text="0.00 Mbps" FontSize="34" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="UploadPeakText" Text="Peak today ↑ 0.00 Mbps" Style="{StaticResource MutedText}" Margin="0,6,0,0"
                                               ToolTip="Highest sampled upload traffic NetTrace observed today across monitored adapters. Saved across restarts; not a speed-test result."/>
                                    <TextBlock x:Name="UploadSessionText" Text="App session ↑ 0 B" Style="{StaticResource MutedText}" Margin="0,8,0,0"
                                               ToolTip="Upload data measured since this NetTrace process started, including time with the dashboard closed."/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,18,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="DATA USAGE" Grid.ColumnSpan="5" Style="{StaticResource MutedText}" Margin="0,0,0,8"
                                       ToolTip="Recorded data quantities in bytes, MB and GB. These are usage totals, not traffic rates."/>

                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="TODAY" Style="{StaticResource MutedText}"/>
                                    <TextBlock x:Name="TodayTotalText" Text="0 B" FontSize="25" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                    <TextBlock x:Name="TodayBreakdownText" Text="↓ 0 B   ↑ 0 B" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="LAST 7 DAYS" Style="{StaticResource MutedText}"/>
                                    <TextBlock x:Name="WeekTotalText" Text="0 B" FontSize="25" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                    <TextBlock x:Name="WeekBreakdownText" Text="↓ 0 B   ↑ 0 B" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="LAST 30 DAYS" Style="{StaticResource MutedText}"/>
                                    <TextBlock x:Name="MonthTotalText" Text="0 B" FontSize="25" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                    <TextBlock x:Name="MonthBreakdownText" Text="↓ 0 B   ↑ 0 B" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="CURRENT CONNECTION" Style="{StaticResource MutedText}"/>
                                    <TextBlock x:Name="DashboardProfileText" Text="{Binding Text, ElementName=CurrentProfileText, Mode=OneWay}"
                                               FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="DashboardNetworkText" Text="{Binding Text, ElementName=CurrentNetworkText, Mode=OneWay}"
                                               Style="{StaticResource MutedText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="24,0,0,0">
                                    <TextBlock Text="CONNECTION SESSION" Style="{StaticResource MutedText}"/>
                                    <TextBlock x:Name="DashboardSessionText" Text="{Binding Text, ElementName=CurrentSessionText, Mode=OneWay}"
                                               FontWeight="SemiBold" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="DashboardSessionUsageText" Text="{Binding Text, ElementName=CurrentSessionUsageText, Mode=OneWay}"
                                               Style="{StaticResource MutedText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0"
                                    ToolTip="Whether NetTrace is collecting traffic. This does not represent network health.">
                            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource StatusPositiveBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Text="Monitoring" Margin="8,0,0,0" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="HealthTab" Header="Health">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="HealthContent">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="NETWORK HEALTH" Style="{StaticResource MutedText}"/>
                                <TextBlock x:Name="HealthWaitingText" Text="Waiting for first measurement..."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>

                                <Grid x:Name="HealthDetailsGrid" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Internet reachability" Style="{StaticResource MutedText}"/>
                                    <TextBlock x:Name="InternetReachabilityText" Grid.Column="1" Text="Checking" TextWrapping="Wrap"
                                               FontWeight="SemiBold" Foreground="{StaticResource StatusNeutralBrush}"
                                               ToolTip="External DNS and HTTPS checks. Available confirms a response from at least one configured HTTPS endpoint, not every internet service."/>

                                    <TextBlock Grid.Row="1" Text="VPN / tunnel" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="HealthVpnStatusText" Grid.Row="1" Grid.Column="1" Text="Unknown" Margin="0,8,0,0"
                                               FontWeight="SemiBold" Foreground="{StaticResource StatusNeutralBrush}"/>

                                    <TextBlock Grid.Row="2" Text="ICMP quality" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="IcmpQualityText" Grid.Row="2" Grid.Column="1" Text="Measuring" TextWrapping="Wrap" Margin="0,8,0,0"
                                               FontWeight="SemiBold" Foreground="{StaticResource StatusInfoBrush}"
                                               ToolTip="Based on up to 12 recent completed ICMP cycles; at least 3 are required. The worst available metric determines quality."/>

                                    <TextBlock Grid.Row="3" Text="Target" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="IcmpTargetText" Grid.Row="3" Grid.Column="1" Text="—" TextWrapping="Wrap" Margin="0,8,0,0"/>

                                    <TextBlock Grid.Row="4" Text="Average latency" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="IcmpLatencyText" Grid.Row="4" Grid.Column="1" Text="—" TextWrapping="Wrap" Margin="0,8,0,0"/>

                                    <TextBlock Grid.Row="5" Text="Jitter" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="IcmpJitterText" Grid.Row="5" Grid.Column="1" Text="—" TextWrapping="Wrap" Margin="0,8,0,0"/>

                                    <TextBlock Grid.Row="6" Text="Packet loss" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="IcmpPacketLossText" Grid.Row="6" Grid.Column="1" Text="—" TextWrapping="Wrap" Margin="0,8,0,0"/>

                                    <TextBlock Grid.Row="7" Text="Successful replies" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="IcmpRepliesText" Grid.Row="7" Grid.Column="1" Text="—" TextWrapping="Wrap" Margin="0,8,0,0"/>

                                    <TextBlock Grid.Row="8" Text="Last sample" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="IcmpLastSampleText" Grid.Row="8" Grid.Column="1" Text="—" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </Grid>

                                <TextBlock x:Name="HealthDisclaimerText" Text="ICMP replies can be blocked; ICMP quality does not determine internet availability. Reachability is checked separately using DNS and HTTPS."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Connection Stability" FontSize="18" FontWeight="SemiBold"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <TextBlock Text="Average latency (ms)" Foreground="{StaticResource AccentBrush}" Margin="0,0,24,0"/>
                                    <TextBlock Text="Jitter (ms)" Foreground="{StaticResource StatusCautionBrush}"/>
                                </WrapPanel>
                                <controls:IcmpStabilityChart x:Name="IcmpStabilityChart" Height="110" Margin="0,10,0,0"
                                                             AutomationProperties.Name="Connection stability, average latency and jitter in milliseconds"/>
                                <TextBlock Text="Packet Loss" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0"
                                           ToolTip="ICMP packet loss per completed probe cycle."/>
                                <controls:IcmpPacketLossChart x:Name="IcmpPacketLossChart" Height="70" Margin="0,6,0,0"
                                                              AutomationProperties.Name="ICMP packet loss history, zero to one hundred percent"/>
                                <TextBlock Text="Up to 60 completed cycles, oldest → newest. Unavailable latency/jitter appear as gaps."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="ConnectionsTab" Header="Connections">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ConnectionsContent">
                        <StackPanel.Resources>
                            <Style TargetType="ToolTip">
                                <Setter Property="MaxWidth" Value="322"/>
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="Background" Value="#172036"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                                <Setter Property="BorderBrush" Value="#2B3957"/>
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="300"/>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </StackPanel.Resources>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="ManageProfilesButton" Content="Profiles" Click="ManageProfiles_OnClick"
                                            DockPanel.Dock="Right" Padding="8,2" Margin="12,0,0,0"/>
                                    <TextBlock Text="CURRENT CONNECTION" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DockPanel Margin="0,8,0,0">
                                    <Button x:Name="AssignProfileButton" Content="Assign profile" Click="AssignProfile_OnClick" DockPanel.Dock="Right"
                                            Padding="8,2" Margin="10,0,0,0" Visibility="Collapsed"/>
                                    <TextBlock x:Name="CurrentProfileText" Text="Detecting connection…" FontSize="18" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock x:Name="CurrentNetworkText" Style="{StaticResource MutedText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                <Grid x:Name="ConnectionRouteGrid" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="VPN / tunnel" Style="{StaticResource MutedText}"/>
                                    <TextBlock x:Name="ConnectionsVpnStatusText" Grid.Column="1" Text="Unknown" FontWeight="SemiBold"
                                               Foreground="{StaticResource StatusNeutralBrush}"/>
                                    <StackPanel x:Name="VpnTransportLabelPanel" Grid.Row="1" Orientation="Horizontal"
                                                HorizontalAlignment="Left" Margin="0,8,0,0">
                                        <TextBlock Text="VPN transport" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                        <controls:NetworkHelpButton x:Name="VpnTransportHelp" Term="VPN transport" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="VpnTransportText" Grid.Row="1" Grid.Column="1" Text="Unknown" FontWeight="SemiBold" Margin="0,8,0,0"
                                               Foreground="{StaticResource StatusNeutralBrush}"/>
                                    <TextBlock Grid.Row="2" Text="IPv4 route" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="IPv4RouteText" Grid.Row="2" Grid.Column="1" Text="Unknown" FontWeight="SemiBold" Margin="0,8,0,0"
                                               Foreground="{StaticResource StatusNeutralBrush}"/>
                                    <TextBlock Grid.Row="3" Text="IPv6 route" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="IPv6RouteText" Grid.Row="3" Grid.Column="1" Text="Unknown" FontWeight="SemiBold" Margin="0,8,0,0"
                                               Foreground="{StaticResource StatusNeutralBrush}"/>
                                    <TextBlock Grid.Row="4" Text="Physical adapter" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="PhysicalAdapterText" Grid.Row="4" Grid.Column="1" Text="Unavailable" Margin="0,8,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <TextBlock Text="CONNECTION SESSION" Style="{StaticResource MutedText}" Margin="0,14,0,0"
                                           ToolTip="One continuous observed physical connection. Sleep, disconnect or a physical network change ends the session."/>
                                <TextBlock x:Name="CurrentSessionText" Text="No active session" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                <TextBlock x:Name="CurrentSessionUsageText" Text="↓ 0 B   ↑ 0 B" Style="{StaticResource MutedText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="MONITORED ADAPTER" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                                <ComboBox x:Name="AdapterComboBox" Foreground="#0F172A" SelectionChanged="AdapterComboBox_OnSelectionChanged"
                                          DisplayMemberPath="Name"/>
                                <Grid x:Name="AdapterDetailsGrid" Margin="0,14,0,0">
                                    <Grid.Resources>
                                        <Style x:Key="AdapterDetailValue" TargetType="TextBlock">
                                            <Setter Property="Text" Value="Unavailable"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </Grid.Resources>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Adapter" Style="{StaticResource MutedText}"/>
                                    <TextBlock x:Name="AdapterNameText" Grid.Column="1" Style="{StaticResource AdapterDetailValue}"/>
                                    <TextBlock Grid.Row="1" Text="Status" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="AdapterStatusText" Grid.Row="1" Grid.Column="1" Text="Unknown" Style="{StaticResource AdapterDetailValue}" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="2" Text="Network" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="AdapterNetworkText" Grid.Row="2" Grid.Column="1" Style="{StaticResource AdapterDetailValue}" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="3" Text="Profile" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="AdapterProfileText" Grid.Row="3" Grid.Column="1" Text="Unassigned" Style="{StaticResource AdapterDetailValue}" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="4" Text="Type" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="AdapterTypeText" Grid.Row="4" Grid.Column="1" Style="{StaticResource AdapterDetailValue}" Margin="0,8,0,0"/>
                                    <StackPanel x:Name="Ipv4LabelPanel" Grid.Row="5" Orientation="Horizontal"
                                                HorizontalAlignment="Left" Margin="0,18,0,0">
                                        <TextBlock Text="IPv4" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                        <controls:NetworkHelpButton x:Name="Ipv4Help" Term="IPv4" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="Ipv4Text" Grid.Row="5" Grid.Column="1" Style="{StaticResource AdapterDetailValue}" Margin="0,18,0,0"/>
                                    <StackPanel x:Name="Ipv6LabelPanel" Grid.Row="6" Orientation="Horizontal"
                                                HorizontalAlignment="Left" Margin="0,8,0,0">
                                        <TextBlock Text="IPv6" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                        <controls:NetworkHelpButton x:Name="Ipv6Help" Term="IPv6" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="Ipv6Text" Grid.Row="6" Grid.Column="1" Style="{StaticResource AdapterDetailValue}" Margin="0,8,0,0"
                                               ToolTip="A usable global or unique-local IPv6 address. Link-local-only IPv6 is shown as Unavailable."/>
                                    <StackPanel x:Name="DefaultGatewayLabelPanel" Grid.Row="7" Orientation="Horizontal"
                                                HorizontalAlignment="Left" Margin="0,8,0,0">
                                        <TextBlock Text="Default gateway" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                        <controls:NetworkHelpButton x:Name="DefaultGatewayHelp" Term="Default gateway" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="DefaultGatewayText" Grid.Row="7" Grid.Column="1" Style="{StaticResource AdapterDetailValue}" Margin="0,8,0,0"/>
                                    <StackPanel x:Name="DnsLabelPanel" Grid.Row="8" Orientation="Horizontal"
                                                HorizontalAlignment="Left" Margin="0,8,0,0">
                                        <TextBlock Text="DNS" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                        <controls:NetworkHelpButton x:Name="DnsHelp" Term="DNS" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="DnsText" Grid.Row="8" Grid.Column="1" Style="{StaticResource AdapterDetailValue}" Margin="0,8,0,0"/>
                                    <StackPanel x:Name="LinkRateLabelPanel" Grid.Row="9" Orientation="Horizontal"
                                                HorizontalAlignment="Left" Margin="0,8,0,0">
                                        <TextBlock x:Name="LinkRateLabel" Text="Adapter link rate" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                        <controls:NetworkHelpButton x:Name="LinkRateHelp" Term="Link rate" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="LinkSpeedText" Grid.Row="9" Grid.Column="1" Style="{StaticResource AdapterDetailValue}" Margin="0,8,0,0"
                                               ToolTip="The local rate reported by the monitored adapter. This is not measured internet speed."/>
                                </Grid>
                                <StackPanel x:Name="WifiRadioSection" Visibility="Collapsed" Margin="0,16,0,0">
                                    <TextBlock Text="WI-FI RADIO" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                    <Grid x:Name="WifiRadioGrid">
                                        <Grid.Resources>
                                            <Style x:Key="WifiRadioValue" TargetType="TextBlock">
                                                <Setter Property="Text" Value="Unavailable"/>
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </Grid.Resources>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel x:Name="WifiSignalQualityLabelPanel" Grid.Row="0" Orientation="Horizontal"
                                                    HorizontalAlignment="Left" Margin="0,8,0,0">
                                            <TextBlock Text="Signal quality" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                            <controls:NetworkHelpButton x:Name="WifiSignalQualityHelp" Term="Signal quality" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock x:Name="WifiSignalQualityText" Grid.Row="0" Grid.Column="1" Style="{StaticResource WifiRadioValue}" Margin="0,8,0,0"/>
                                        <StackPanel x:Name="WifiRssiLabelPanel" Grid.Row="1" Orientation="Horizontal"
                                                    HorizontalAlignment="Left" Margin="0,8,0,0">
                                            <TextBlock Text="RSSI" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                            <controls:NetworkHelpButton x:Name="WifiRssiHelp" Term="RSSI" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock x:Name="WifiRssiText" Grid.Row="1" Grid.Column="1" Style="{StaticResource WifiRadioValue}" Margin="0,8,0,0"/>
                                        <StackPanel x:Name="WifiChannelLabelPanel" Grid.Row="2" Orientation="Horizontal"
                                                    HorizontalAlignment="Left" Margin="0,8,0,0">
                                            <TextBlock Text="Channel" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                            <controls:NetworkHelpButton x:Name="WifiChannelHelp" Term="Channel" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock x:Name="WifiChannelText" Grid.Row="2" Grid.Column="1" Style="{StaticResource WifiRadioValue}" Margin="0,8,0,0"/>
                                        <StackPanel x:Name="WifiBandFrequencyLabelPanel" Grid.Row="3" Orientation="Horizontal"
                                                    HorizontalAlignment="Left" Margin="0,8,0,0">
                                            <TextBlock Text="Band / Frequency" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                            <controls:NetworkHelpButton x:Name="WifiBandFrequencyHelp" Term="Band / Frequency" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock x:Name="WifiBandFrequencyText" Grid.Row="3" Grid.Column="1" Style="{StaticResource WifiRadioValue}" Margin="0,8,0,0"/>
                                        <StackPanel x:Name="WifiBssidLabelPanel" Grid.Row="4" Orientation="Horizontal"
                                                    HorizontalAlignment="Left" Margin="0,8,0,0">
                                            <TextBlock Text="BSSID" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                            <controls:NetworkHelpButton x:Name="WifiBssidHelp" Term="BSSID" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock x:Name="WifiBssidText" Grid.Row="4" Grid.Column="1" Style="{StaticResource WifiRadioValue}" Margin="0,8,0,0"/>
                                        <StackPanel x:Name="WifiPhyLabelPanel" Grid.Row="5" Orientation="Horizontal"
                                                    HorizontalAlignment="Left" Margin="0,8,0,0">
                                            <TextBlock Text="PHY / radio type" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                            <controls:NetworkHelpButton x:Name="WifiPhyHelp" Term="PHY / radio type" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock x:Name="WifiPhyText" Grid.Row="5" Grid.Column="1" Style="{StaticResource WifiRadioValue}" Margin="0,8,0,0"/>
                                        <StackPanel x:Name="WifiReceiveLinkRateLabelPanel" Grid.Row="6" Orientation="Horizontal"
                                                    HorizontalAlignment="Left" Margin="0,8,0,0">
                                            <TextBlock Text="Receive link rate" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                            <controls:NetworkHelpButton x:Name="WifiReceiveLinkRateHelp" Term="Receive link rate" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock x:Name="WifiReceiveLinkRateText" Grid.Row="6" Grid.Column="1" Style="{StaticResource WifiRadioValue}" Margin="0,8,0,0"/>
                                        <StackPanel x:Name="WifiTransmitLinkRateLabelPanel" Grid.Row="7" Orientation="Horizontal"
                                                    HorizontalAlignment="Left" Margin="0,8,0,0">
                                            <TextBlock Text="Transmit link rate" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                            <controls:NetworkHelpButton x:Name="WifiTransmitLinkRateHelp" Term="Transmit link rate" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock x:Name="WifiTransmitLinkRateText" Grid.Row="7" Grid.Column="1" Style="{StaticResource WifiRadioValue}" Margin="0,8,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="HistoryTab" Header="History">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="CONNECTION HISTORY" Style="{StaticResource MutedText}"/>
                            <TextBlock Text="Review recent connection sessions and events."
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <Button x:Name="ViewHistoryButton" Content="View history" Click="ViewHistory_OnClick"
                                    HorizontalAlignment="Left" Padding="12,6" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="SettingsTab" Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SettingsContent">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="WINDOWS STARTUP" Style="{StaticResource MutedText}"/>
                                <CheckBox x:Name="StartWithWindowsCheckBox" Click="StartWithWindows_OnClick"
                                          Foreground="#F8FAFC" FontSize="13" Margin="0,12,0,0"
                                          ToolTip="Start monitoring in the system tray when you sign in to Windows.">
                                    <TextBlock Text="Start NetTrace with Windows" TextWrapping="Wrap"/>
                                </CheckBox>
                                <TextBlock x:Name="StartupSettingMessageText" Text="" Foreground="#FBBF24"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Text="Launch in the system tray when you sign in. Open the dashboard from the tray when needed."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="LOCAL DATA" Style="{StaticResource MutedText}"/>
                                <TextBlock Text="Usage, connection history and profiles are stored in this local SQLite database."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock x:Name="DatabasePathText" Text="" TextWrapping="Wrap" Foreground="#CBD5E1"
                                           FontSize="12" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="SessionMessageText" Grid.Row="3" Text="" Foreground="#FBBF24"
                   FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </Grid>
</Window>
