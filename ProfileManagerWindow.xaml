<Window x:Class="NetTrace.ProfileManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetTrace profiles" Width="700" Height="550" MinWidth="620" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="#0A1020" Foreground="#F8FAFC">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#172036"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#2B3957"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="#172036"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#2B3957"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#111A2E"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#2B3957"/>
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock x:Name="HeadingText" Text="Connection profiles" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="AssignmentText" Text="Select a profile to edit, or create a new one." Foreground="#94A3B8"
                       Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel>
                <Button x:Name="NewProfileButton" Content="New profile" Click="NewProfile_OnClick" DockPanel.Dock="Bottom" Margin="0,10,0,0"/>
                <ListBox x:Name="ProfilesList" DisplayMemberPath="DisplayName" SelectionChanged="ProfilesList_OnSelectionChanged"/>
            </DockPanel>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Telco / ISP" Foreground="#94A3B8" Margin="0,0,0,5"/>
                    <TextBox x:Name="TelcoNameBox" MaxLength="200" TextChanged="ProfileFields_OnTextChanged"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <TextBlock Text="Device" Foreground="#94A3B8" Margin="0,0,0,5"/>
                    <TextBox x:Name="DeviceNameBox" MaxLength="200" TextChanged="ProfileFields_OnTextChanged"/>
                </StackPanel>
                <TextBlock x:Name="PreviewText" Grid.Row="2" FontSize="17" FontWeight="SemiBold" Margin="0,14,0,0" TextTrimming="CharacterEllipsis"/>
                <WrapPanel Grid.Row="3" Margin="0,12,0,0">
                    <Button x:Name="SaveProfileButton" Content="Save profile" Click="SaveProfile_OnClick" Margin="0,0,8,0"/>
                    <Button x:Name="AssignNetworkButton" Content="Assign this network" Click="AssignNetwork_OnClick" Visibility="Collapsed"/>
                </WrapPanel>
                <TextBlock Grid.Row="4" Text="Known network mappings" Foreground="#94A3B8" Margin="0,18,0,7"/>
                <ListBox x:Name="MappingsList" Grid.Row="5">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4">
                                <TextBlock Text="{Binding TypeDisplayName}" Foreground="#94A3B8" FontSize="11"/>
                                <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="#FBBF24" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Close" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
