<ResourceDictionary x:Class="NetTrace.Resources.StatusColors"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="StatusPositiveBrush" Color="#22C55E"/>
    <SolidColorBrush x:Key="StatusCautionBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="StatusNegativeBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="StatusInfoBrush" Color="#38BDF8"/>
    <SolidColorBrush x:Key="StatusNeutralBrush" Color="#94A3B8"/>
</ResourceDictionary>
